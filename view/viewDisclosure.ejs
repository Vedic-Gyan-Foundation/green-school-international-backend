<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Public Disclosure Documents - The Green School International</title>
    <style>
        :root {
            --primary-color: #3d405b;
            --secondary-color: #81b29a;
            --accent-color: #f2cc8f;
            --bg-color: #f4f1de;
            --text-color: #3d405b;
            --danger-color: #e07a5f;
            --muted: #8a8ba0;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--primary-color);
        }

        h1 {
            color: var(--primary-color);
            margin: 0;
        }

        .live-link {
            color: var(--primary-color);
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

        .live-link:hover { text-decoration: underline; }

        .btn {
            padding: 10px 20px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary { background-color: var(--primary-color); color: white; }
        .btn-primary:hover { background-color: #2a2c3e; }

        .btn-danger { background-color: var(--danger-color); color: white; }
        .btn-danger:hover { background-color: #c05c45; }

        .btn-secondary { background-color: #e4e2d7; color: var(--primary-color); }
        .btn-secondary:hover { background-color: #d7d4c6; }

        .btn-sm {
            padding: 6px 14px;
            font-size: 13px;
        }

        .btn:disabled {
            background-color: #c5cfc9;
            color: #fff;
            cursor: not-allowed;
        }

        .explainer {
            background: #fffdf5;
            border: 1px solid #e4e2d7;
            border-left: 4px solid var(--secondary-color);
            border-radius: 6px;
            padding: 16px 20px;
            margin-bottom: 30px;
            font-size: 14px;
            line-height: 1.6;
        }

        .explainer p { margin: 0 0 8px; }
        .explainer p:last-child { margin-bottom: 0; }

        .section-block { margin-bottom: 45px; }

        .section-block h2 {
            color: var(--primary-color);
            font-size: 20px;
            margin: 0 0 4px;
        }

        .section-note {
            color: var(--muted);
            font-size: 13px;
            margin: 0 0 14px;
        }

        .group-caption {
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            margin: 22px 0 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-wrapper {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            text-align: left;
            padding: 15px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #777;
            border-bottom: 2px solid #eee;
            white-space: nowrap;
        }

        tbody td {
            padding: 15px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: top;
            font-size: 14px;
        }

        tbody tr:last-child td { border-bottom: none; }

        tbody tr:hover { background-color: #fafafa; }

        tbody tr.row-hidden { background-color: #f7f6f1; }
        tbody tr.row-hidden .doc-title { color: var(--muted); }

        .sl-cell {
            width: 70px;
            font-weight: 600;
            color: var(--primary-color);
        }

        .doc-title {
            font-weight: 500;
            color: var(--primary-color);
            max-width: 480px;
            line-height: 1.5;
        }

        .file-link {
            color: var(--secondary-color);
            font-weight: 600;
            word-break: break-all;
        }

        .file-link:hover { text-decoration: underline; }

        .file-hint {
            display: block;
            color: var(--muted);
            font-size: 12px;
            margin-top: 4px;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .badge-hidden {
            background-color: #f1f1f1;
            color: #777;
            margin-top: 8px;
        }

        .muted { color: var(--muted); }

        .actions-cell { width: 330px; }

        .replace-row {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .replace-row input[type="file"] {
            font-size: 12px;
            max-width: 190px;
        }

        .row-actions {
            margin-top: 10px;
            display: flex;
            gap: 8px;
        }

        .row-status {
            font-size: 13px;
            margin-top: 8px;
            display: none;
        }

        .row-status.show { display: block; }
        .row-status.working { color: var(--muted); }
        .row-status.done { color: #2f6b4f; font-weight: 600; }
        .row-status.error { color: var(--danger-color); font-weight: 600; }

        .section-footer { margin-top: 18px; }

        .empty-state {
            background: white;
            border-radius: 8px;
            padding: 30px;
            text-align: center;
            color: var(--muted);
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/admin" style="display:inline-block;margin-bottom:20px;color:#3d405b;text-decoration:none;font-size:14px;">&larr; Back to Admin Dashboard</a>
        <header>
            <h1>Public Disclosure Documents</h1>
            <a class="live-link" href="https://greenschoolguwahati.com/publicdisclosure" target="_blank" rel="noopener noreferrer">
                View the live page &#8599;
            </a>
        </header>

        <div class="explainer">
            <p>
                This page controls sections <strong>B</strong> and <strong>C</strong> of the CBSE public
                disclosure page on the school website. Everything you see here appears there, in this order.
            </p>
            <p>
                <strong>Replace file</strong> swaps the document behind the &ldquo;Click to Download&rdquo; link.
                The row, the link and its wording stay exactly the same &mdash; only the document a visitor
                downloads changes. <strong>Edit</strong> changes the wording of a row, its section and where it
                sits. <strong>Add new row</strong> puts a new numbered row at the bottom of that section.
            </p>
            <p>
                The SL numbers below are the numbers a visitor sees. They are worked out from the order of the
                rows, so deleting or hiding a row renumbers the ones under it automatically. Changes are live
                on the website straight away.
            </p>
        </div>

        <%
            const blocks = [
                { letter: 'B', heading: 'Section B — Documents and Information', rows: sectionB || [] },
                { letter: 'C', heading: 'Section C — Result and Academics', rows: sectionC || [] }
            ];

            // A row saved under any other letter would otherwise be invisible here, and the
            // schema deliberately allows one (a future section D of documents).
            const others = otherSections || [];
            [...new Set(others.map((row) => row.section))].sort().forEach((letter) => {
                blocks.push({
                    letter: letter,
                    heading: 'Section ' + letter,
                    rows: others.filter((row) => row.section === letter)
                });
            });

            const fileName = (url) => {
                const value = String(url || '');
                const withoutQuery = value.split('?')[0];
                let decoded = withoutQuery;
                try {
                    decoded = decodeURIComponent(withoutQuery);
                } catch (error) {
                    decoded = withoutQuery;
                }
                return decoded.substring(decoded.lastIndexOf('/') + 1) || decoded;
            };
        %>

        <% blocks.forEach((block) => { %>
            <div class="section-block">
                <h2><%= block.heading %></h2>
                <p class="section-note">
                    <%= block.rows.length %> row(s) on the website under this heading.
                </p>

                <% if (block.rows.length === 0) { %>
                    <div class="empty-state">
                        Nothing in this section yet. Use the button below to add the first row.
                    </div>
                <% } else { %>
                    <%
                        const groups = [
                            { numbered: true, rows: block.rows.filter((row) => row.is_numbered) },
                            { numbered: false, rows: block.rows.filter((row) => !row.is_numbered) }
                        ];
                        // SL No. is the position among VISIBLE numbered rows, which is what the
                        // website prints — not display_order and not the id.
                        let slNo = 0;
                    %>
                    <% groups.forEach((group) => { %>
                        <% if (group.rows.length > 0) { %>
                            <% if (!group.numbered) { %>
                                <p class="group-caption">
                                    Extra row(s) &mdash; shown under the numbered table on the website, without an SL number
                                </p>
                            <% } %>
                            <div class="table-wrapper">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>SL No.</th>
                                            <th>Documents / Information</th>
                                            <th>Current file</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% group.rows.forEach((row) => { %>
                                            <% if (group.numbered && row.is_visible) { slNo++; } %>
                                            <tr id="row-<%= row.id %>" class="<%= row.is_visible ? '' : 'row-hidden' %>">
                                                <td class="sl-cell">
                                                    <% if (group.numbered && row.is_visible) { %>
                                                        <%= slNo %>
                                                    <% } else { %>
                                                        <span class="muted">&mdash;</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="doc-title"><%= row.title %></div>
                                                    <% if (!row.is_visible) { %>
                                                        <span class="badge badge-hidden">Hidden &mdash; not on the website</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <a class="file-link" href="<%= row.file_url %>" target="_blank" rel="noopener noreferrer">
                                                        <% if (row.link_type === 'view') { %>
                                                            <%= row.file_url %>
                                                        <% } else { %>
                                                            <%= fileName(row.file_url) %>
                                                        <% } %>
                                                    </a>
                                                    <span class="file-hint">
                                                        Opens in a new tab &mdash; check it before replacing.
                                                        Link reads &ldquo;<%= row.link_label %>&rdquo;.
                                                    </span>
                                                </td>
                                                <td class="actions-cell">
                                                    <% if (row.link_type === 'view') { %>
                                                        <%# This row points at a web page, not a file — uploading one would repoint a
                                                            "Click to View" link at a PDF. The address is changed on the Edit page. %>
                                                        <span class="file-hint" style="margin-top:0;">
                                                            This row is a web address, not a file. Use Edit to change where it points.
                                                        </span>
                                                    <% } else { %>
                                                        <div class="replace-row">
                                                            <input type="file" id="file-<%= row.id %>" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx" onchange="showPicked(<%= row.id %>)">
                                                            <button class="btn btn-secondary btn-sm" id="replace-btn-<%= row.id %>" onclick="replaceFile(<%= row.id %>)">Replace file</button>
                                                        </div>
                                                    <% } %>
                                                    <div class="row-actions">
                                                        <a class="btn btn-primary btn-sm" href="/admin/disclosure/edit/<%= row.id %>">Edit</a>
                                                        <button class="btn btn-danger btn-sm" data-title="<%= row.title %>" onclick="deleteRow(<%= row.id %>, this.dataset.title)">Delete</button>
                                                    </div>
                                                    <div class="row-status" id="status-<%= row.id %>"></div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    <% }); %>
                <% } %>

                <div class="section-footer">
                    <a class="btn btn-primary" href="/admin/disclosure/add?section=<%= block.letter %>">+ Add new row to Section <%= block.letter %></a>
                </div>
            </div>
        <% }); %>
    </div>

    <script>
        function setStatus(id, kind, message) {
            const box = document.getElementById(`status-${id}`);
            box.className = `row-status show ${kind}`;
            box.textContent = message;
        }

        // nginx refuses an upload over 20MB with its own HTML error page, which response.json()
        // would surface as a syntax error nobody can act on.
        async function readJson(response) {
            try {
                return await response.json();
            } catch (error) {
                if (response.status === 413) {
                    throw new Error('That file is too large for the server. Keep it under 20 MB.');
                }
                throw new Error(`The server gave an unexpected reply (HTTP ${response.status}).`);
            }
        }

        function showPicked(id) {
            const file = document.getElementById(`file-${id}`).files[0];
            if (file) {
                setStatus(id, 'working', `Ready to upload: ${file.name} — click Replace file.`);
            }
        }

        // One step: the picked file is uploaded and the row repointed at it by the same
        // request, so nobody ever handles a URL by hand.
        async function replaceFile(id) {
            const input = document.getElementById(`file-${id}`);
            const file = input.files[0];

            if (!file) {
                setStatus(id, 'error', 'Choose a file first, then click Replace file.');
                return;
            }

            const button = document.getElementById(`replace-btn-${id}`);
            button.disabled = true;
            button.textContent = 'Uploading...';
            setStatus(id, 'working', `Uploading ${file.name}...`);

            const formData = new FormData();
            formData.append('document', file);

            try {
                const response = await fetch(`/v1/disclosure/update/${id}`, {
                    method: 'PUT',
                    body: formData,
                    credentials: 'same-origin'
                });
                const result = await readJson(response);

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Replace failed');
                }

                setStatus(id, 'done', 'Replaced. Refreshing the list...');
                setTimeout(() => location.reload(), 900);
            } catch (error) {
                console.error('Replace disclosure file error:', error);
                setStatus(id, 'error', `Could not replace the file: ${error.message}`);
                button.disabled = false;
                button.textContent = 'Replace file';
            }
        }

        async function deleteRow(id, title) {
            const message =
                `Delete this row?\n\n"${title}"\n\n` +
                'It disappears from the website and the rows under it move up a number.';
            if (!confirm(message)) return;

            try {
                const response = await fetch(`/v1/disclosure/delete/${id}`, {
                    method: 'DELETE',
                    credentials: 'same-origin'
                });
                const result = await readJson(response);

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Delete failed');
                }

                // Reload rather than drop the row: the SL numbers below it have all shifted.
                location.reload();
            } catch (error) {
                console.error('Delete disclosure row error:', error);
                setStatus(id, 'error', `Could not delete: ${error.message}`);
            }
        }
    </script>
</body>
</html>
