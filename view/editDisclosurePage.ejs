<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Disclosure Row - The Green School International</title>
    <style>
        :root {
            --primary-color: #3d405b;
            --secondary-color: #81b29a;
            --accent-color: #f2cc8f;
            --bg-color: #f4f1de;
            --text-color: #3d405b;
            --danger-color: #e07a5f;
            --muted: #8a8ba0;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        .container {
            background-color: white;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 880px;
            margin-top: 20px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        h1 { margin: 0; color: var(--primary-color); }

        .back-link { color: var(--muted); text-decoration: none; font-size: 14px; }
        .back-link:hover { color: var(--primary-color); }

        .lede {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
            margin: 0 0 28px;
        }

        .form-group { margin-bottom: 22px; }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--primary-color);
        }

        .hint { font-size: 13px; color: var(--muted); font-weight: 400; margin-top: 5px; line-height: 1.5; }

        select,
        textarea,
        input[type="text"],
        input[type="url"],
        input[type="number"] {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #d9d7cc;
            border-radius: 6px;
            font-size: 15px;
            font-family: inherit;
            background: #fff;
            color: var(--text-color);
        }

        textarea { min-height: 90px; resize: vertical; line-height: 1.5; }

        select:focus, textarea:focus, input:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(129, 178, 154, 0.18);
        }

        .current-file {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 14px;
            border: 1px solid #e4e2d7;
            border-radius: 8px;
            background: #fcfbf6;
        }

        .current-file .file-icon { font-size: 26px; }

        .current-file a {
            color: var(--secondary-color);
            font-weight: 600;
            word-break: break-all;
        }

        .current-file a:hover { text-decoration: underline; }

        .file-chosen {
            font-size: 13px;
            color: var(--secondary-color);
            font-weight: 600;
            margin-top: 8px;
            min-height: 18px;
        }

        input[type="file"] {
            width: 100%;
            padding: 11px 12px;
            border: 1px dashed #d9d7cc;
            border-radius: 6px;
            background: #fff;
            font-size: 14px;
            margin-top: 12px;
        }

        .checkbox-row { display: flex; align-items: center; gap: 9px; }
        .checkbox-row input { width: 18px; height: 18px; }
        .checkbox-row label { margin: 0; font-weight: 400; }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
        }

        @media (max-width: 620px) {
            .two-col { grid-template-columns: 1fr; }
        }

        .actions { display: flex; gap: 12px; margin-top: 8px; }

        button.submit {
            flex: 1;
            padding: 14px;
            background-color: var(--secondary-color);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

        button.submit:hover:not(:disabled) { background-color: #6a9c84; }
        button.submit:disabled { background-color: #c5cfc9; cursor: not-allowed; }

        a.cancel {
            padding: 14px 22px;
            border-radius: 6px;
            background: #e4e2d7;
            color: var(--primary-color);
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
        }

        a.cancel:hover { background: #d7d4c6; }

        .banner {
            padding: 13px 15px;
            border-radius: 6px;
            margin-bottom: 22px;
            display: none;
            font-size: 15px;
        }

        .banner.show { display: block; }
        .banner.success { background: #e8f3ed; color: #2f6b4f; border: 1px solid var(--secondary-color); }
        .banner.error { background: #fbeae5; color: #a4432a; border: 1px solid var(--danger-color); }
    </style>
</head>
<body>
    <div class="container">
        <div class="topbar">
            <h1>Edit Disclosure Row</h1>
            <a class="back-link" href="/admin/disclosure">&larr; Back to Public Disclosure</a>
        </div>
        <p class="lede">
            This is one row of section <%= item.section %> on
            <a href="https://greenschoolguwahati.com/publicdisclosure" target="_blank" rel="noopener noreferrer">the public disclosure page</a>.
            The link on the website keeps reading &ldquo;<%= item.link_label %>&rdquo; whatever you change here.
        </p>

        <div id="banner" class="banner"></div>

        <form id="disclosureForm">
            <div class="form-group">
                <label for="title">Documents / Information</label>
                <textarea id="title" required><%= item.title %></textarea>
                <div class="hint">The wording shown in the middle column of the table.</div>
            </div>

            <% if (item.link_type === 'view') { %>
                <div class="form-group">
                    <label for="file_url">Link address</label>
                    <input type="url" id="file_url" value="<%= item.file_url %>">
                    <div class="hint">
                        This row opens a web page in a new tab instead of downloading a document, so it is an
                        address rather than a file.
                        <a href="<%= item.file_url %>" target="_blank" rel="noopener noreferrer">Open it to check</a>.
                    </div>
                </div>
            <% } else { %>
                <div class="form-group">
                    <label>Current document</label>
                    <div class="current-file">
                        <span class="file-icon">&#128196;</span>
                        <a href="<%= item.file_url %>" target="_blank" rel="noopener noreferrer" id="currentFileLink">
                            <%= currentFileName %>
                        </a>
                        <span class="hint" style="margin:0;">Opens in a new tab &mdash; check it before you replace it.</span>
                    </div>
                    <input type="file" id="document" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx">
                    <div class="file-chosen" id="fileChosen"></div>
                    <div class="hint">
                        Leave this empty to keep the document above. Choose a file and the row points at the new
                        one as soon as you save &mdash; the link and its wording do not change.
                    </div>
                </div>
            <% } %>

            <div class="two-col">
                <div class="form-group">
                    <label for="section">Section</label>
                    <select id="section">
                        <option value="B" <%= item.section === 'B' ? 'selected' : '' %>>B &mdash; Documents and Information</option>
                        <option value="C" <%= item.section === 'C' ? 'selected' : '' %>>C &mdash; Result and Academics</option>
                        <% if (item.section !== 'B' && item.section !== 'C') { %>
                            <option value="<%= item.section %>" selected><%= item.section %></option>
                        <% } %>
                    </select>
                    <div class="hint">Which table on the website this row sits in.</div>
                </div>

                <div class="form-group">
                    <label for="display_order">Position in this section</label>
                    <input type="number" id="display_order" min="1" step="1" value="<%= item.display_order %>">
                    <div class="hint">
                        1 puts it at the top. The SL numbers a visitor sees are worked out from these positions,
                        so the rows around it renumber themselves.
                    </div>
                </div>
            </div>

            <div class="form-group checkbox-row">
                <input type="checkbox" id="is_visible" <%= item.is_visible ? 'checked' : '' %>>
                <label for="is_visible">Show this row on the website</label>
            </div>

            <div class="form-group checkbox-row">
                <input type="checkbox" id="is_numbered" <%= item.is_numbered ? 'checked' : '' %>>
                <label for="is_numbered">Give this row an SL number in the main table</label>
            </div>
            <div class="hint" style="margin-top:-14px;">
                Unticked, the row sits in the small table underneath without a number &mdash; that is
                where the inspection video link lives.
            </div>

            <div class="actions">
                <button type="submit" class="submit" id="submitBtn">Save Changes</button>
                <a class="cancel" href="/admin/disclosure">Cancel</a>
            </div>
        </form>
    </div>

    <script>
        const $ = (id) => document.getElementById(id);
        const banner = $('banner');
        const submitBtn = $('submitBtn');
        const fileInput = $('document');

        // nginx refuses an upload over 20MB with its own HTML error page, which response.json()
        // would surface as a syntax error nobody can act on.
        const readJson = async (response) => {
            try {
                return await response.json();
            } catch (error) {
                if (response.status === 413) {
                    throw new Error('That file is too large for the server. Keep it under 20 MB.');
                }
                throw new Error(`The server gave an unexpected reply (HTTP ${response.status}).`);
            }
        };

        const showBanner = (kind, text) => {
            banner.className = 'banner show ' + kind;
            banner.textContent = text;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };

        if (fileInput) {
            fileInput.addEventListener('change', () => {
                const file = fileInput.files[0];
                $('fileChosen').textContent = file
                    ? 'New document ready: ' + file.name + ' — it replaces the one above when you save.'
                    : '';
            });
        }

        $('disclosureForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            banner.className = 'banner';

            const title = $('title').value.trim();
            if (!title) {
                showBanner('error', 'The wording of the row cannot be empty.');
                return;
            }

            // One request does the lot: the file (when a new one was picked) travels with the
            // fields, so there is never a half-saved row or a URL to copy.
            const formData = new FormData();
            formData.append('title', title);
            formData.append('section', $('section').value);
            formData.append('display_order', $('display_order').value);
            formData.append('is_visible', $('is_visible').checked ? 'true' : 'false');
            formData.append('is_numbered', $('is_numbered').checked ? 'true' : 'false');

            if ($('file_url')) {
                formData.append('file_url', $('file_url').value.trim());
            }
            if (fileInput && fileInput.files[0]) {
                formData.append('document', fileInput.files[0]);
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';

            try {
                const response = await fetch('/v1/disclosure/update/<%= item.id %>', {
                    method: 'PUT',
                    body: formData,
                    credentials: 'same-origin'
                });
                const result = await readJson(response);

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Update failed');
                }

                if (result.data && result.data.file_url && $('currentFileLink')) {
                    const url = result.data.file_url;
                    $('currentFileLink').href = url;
                    $('currentFileLink').textContent = decodeURIComponent(
                        url.split('?')[0].split('/').pop()
                    );
                }
                if (fileInput) {
                    fileInput.value = '';
                    $('fileChosen').textContent = '';
                }

                showBanner('success', 'Saved. The website shows the change straight away.');
            } catch (error) {
                console.error('Update disclosure row error:', error);
                showBanner('error', 'Could not save: ' + error.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Save Changes';
            }
        });
    </script>
</body>
</html>
