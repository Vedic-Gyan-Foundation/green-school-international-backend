<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Gallery Item - The Green School International</title>
    <style>
        :root {
            --primary-color: #3d405b;
            --secondary-color: #81b29a;
            --accent-color: #f2cc8f;
            --bg-color: #f4f1de;
            --text-color: #3d405b;
            --danger-color: #e07a5f;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        .container {
            background-color: white;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 700px;
            margin-top: 20px;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
            color: var(--primary-color);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input[type="text"],
        input[type="file"] {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            box-sizing: border-box;
        }

        button, .btn {
            padding: 12px 20px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        button:hover, .btn:hover {
            background-color: #2a2c3e;
        }

        .btn-submit {
            width: 100%;
        }

        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--primary-color);
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* Preview area */
        #preview-area {
            margin-top: 20px;
        }

        .preview-item {
            display: flex;
            gap: 15px;
            align-items: flex-start;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
            background: #fafafa;
            position: relative;
        }

        .preview-item img {
            width: 120px;
            height: 90px;
            object-fit: cover;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .preview-item .fields {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .preview-item .fields input {
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
        }

        .preview-item .remove-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--danger-color);
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .preview-item .remove-btn:hover {
            background: #c05c45;
        }

        .file-count {
            text-align: center;
            color: #666;
            margin-top: 10px;
            font-size: 14px;
        }

        .items-label {
            display: block;
            font-weight: 600;
            margin-bottom: 10px;
            color: #3d405b;
        }

        .preview-item .thumb {
            width: 90px;
            height: 68px;
            flex-shrink: 0;
            border-radius: 4px;
            overflow: hidden;
        }

        .preview-item .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .preview-item .thumb.placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px dashed #c9c7bb;
            background: #f1efe6;
            color: #9a998c;
            font-size: 12px;
        }

        .btn-submit:disabled {
            background-color: #c5cfc9;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Add Gallery Items</h1>

        <% if (locals.success) { %>
            <div class="alert alert-success">
                Gallery item(s) added successfully!
            </div>
        <% } %>

        <form id="galleryForm" action="/v1/gallery/add" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label for="gallery_image">Select Image(s)</label>
                <input type="file" id="gallery_image" name="gallery_image" accept="image/*" multiple required>
                <div class="file-count" id="fileCount">No image selected yet</div>
            </div>

            <label class="items-label">Title &amp; Caption</label>
            <div id="preview-area">
                <!-- The first row is always present so the file picker and the title sit on
                     screen together. Selecting more than one image adds a row per extra file. -->
                <div class="preview-item" data-index="0">
                    <div class="thumb placeholder" data-thumb>
                        <span>No image</span>
                    </div>
                    <div class="fields">
                        <input type="text" name="caption" placeholder="Title / caption for this image" required>
                        <input type="text" name="sub_caption" placeholder="Sub-caption (optional)">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn" disabled>Upload &amp; Create</button>
        </form>

        <a href="/admin/gallery" class="back-link">&larr; Back to Gallery</a>
    </div>

    <script>
        const fileInput = document.getElementById('gallery_image');
        const previewArea = document.getElementById('preview-area');
        const submitBtn = document.getElementById('submitBtn');
        const fileCount = document.getElementById('fileCount');

        const rowTemplate = (index) => `
            <div class="preview-item" data-index="${index}">
                <div class="thumb placeholder" data-thumb><span>No image</span></div>
                <div class="fields">
                    <input type="text" name="caption" placeholder="Title / caption for this image" required>
                    <input type="text" name="sub_caption" placeholder="Sub-caption (optional)">
                </div>
                <button type="button" class="remove-btn" title="Remove" onclick="removeFile(${index})">&times;</button>
            </div>`;

        // Keep whatever has already been typed, so choosing a file never wipes a caption.
        const readTyped = () =>
            Array.from(previewArea.querySelectorAll('.preview-item')).map((row) => ({
                caption: row.querySelector('input[name="caption"]').value,
                sub_caption: row.querySelector('input[name="sub_caption"]').value
            }));

        const render = () => {
            const files = Array.from(fileInput.files);
            const typed = readTyped();
            const rows = Math.max(files.length, 1);

            previewArea.innerHTML = Array.from({ length: rows }, (_, i) => rowTemplate(i)).join('');

            previewArea.querySelectorAll('.preview-item').forEach((row, i) => {
                if (typed[i]) {
                    row.querySelector('input[name="caption"]').value = typed[i].caption || '';
                    row.querySelector('input[name="sub_caption"]').value = typed[i].sub_caption || '';
                }
                // The remove button only makes sense once there is a file behind the row.
                const remove = row.querySelector('.remove-btn');
                if (remove && !files[i]) remove.remove();
            });

            files.forEach((file, i) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const holder = previewArea.querySelector(`.preview-item[data-index="${i}"] [data-thumb]`);
                    if (holder) {
                        holder.classList.remove('placeholder');
                        holder.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                    }
                };
                reader.readAsDataURL(file);
            });

            fileCount.textContent = files.length
                ? files.length + ' image(s) selected'
                : 'No image selected yet';
            submitBtn.disabled = files.length === 0;
        };

        function removeFile(index) {
            const dt = new DataTransfer();
            Array.from(fileInput.files).forEach((file, i) => {
                if (i !== index) dt.items.add(file);
            });
            fileInput.files = dt.files;
            render();
        }

        fileInput.addEventListener('change', render);

        // A caption is only required for rows that actually have a file behind them.
        document.getElementById('galleryForm').addEventListener('submit', (e) => {
            const files = Array.from(fileInput.files);
            if (files.length === 0) {
                e.preventDefault();
                fileCount.textContent = 'Choose at least one image first.';
                return;
            }
            const missing = Array.from(previewArea.querySelectorAll('.preview-item'))
                .slice(0, files.length)
                .some((row) => !row.querySelector('input[name="caption"]').value.trim());
            if (missing) {
                e.preventDefault();
                alert('Give every selected image a title/caption.');
                return;
            }
            submitBtn.disabled = true;
            submitBtn.textContent = 'Uploading...';
        });

        render();
    </script>
</body>
</html>
